# Dependencies
**/node_modules
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# The Vercel function bundle: 3.8MB of inlined dependencies, produced by
# `pnpm vercel-build`. Its hand-written `api/app.generated.d.ts` IS committed,
# so `pnpm check` passes on a clone that has not been built yet.
api/app.generated.js

# Secrets. `.env` is written by `pnpm setup:env` and never committed — it holds
# the database password and the Firebase service-account private key.
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*.swp
*~

# Logs and coverage
*.log
coverage/

# The native iOS app (Frontend/iOS). Xcode's per-developer state and the
# build products xcodebuild writes beside the project are never committed.
**/xcuserdata/
Frontend/iOS/build/
Frontend/iOS/DerivedData/
*.xcresult

# The AI gateway's local state and its local secrets (`wrangler dev`).
Backend/gateway/.wrangler/
Backend/gateway/.dev.vars
