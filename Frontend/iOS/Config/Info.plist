<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NetLet</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NetLet uses your location only to move the map to where you are, so you can pin your door for the driver.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NetLet listens only while you hold a search or a question open, so you can say it instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are turned into text by Apple's speech recognition and written into the box for you to check before anything is sent.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a product to search for it on NetLet. It is sent only when you press search.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NetLetAPIBaseURL</key>
	<string>$(NETLET_API_BASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>InterVariable.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
