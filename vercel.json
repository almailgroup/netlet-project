{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/products/:handle",
      "destination": "/api?__page=/products/:handle",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/category/:slug",
      "destination": "/api?__page=/category/:slug",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/stores/:slug",
      "destination": "/api?__page=/stores/:slug",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/stores",
      "destination": "/api?__page=/stores",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/categories",
      "destination": "/api?__page=/categories",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/guides/:slug",
      "destination": "/api?__page=/guides/:slug",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/guides",
      "destination": "/api?__page=/guides",
      "missing": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(admin|vendor)\\..+$"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 15 * * *"
    }
  ]
}
