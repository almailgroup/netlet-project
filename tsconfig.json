{
  "include": ["Frontend/Web/src/**/*", "Frontend/Web/build/**/*.ts", "Shared/**/*", "Backend/src/**/*", "Backend/database/**/*.ts", "Backend/scripts/**/*.ts", "Backend/gateway/src/**/*", "Frontend/iOS/scripts/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    // Node 20 and every browser the storefront supports. Without it tsc
    // defaults to ES5 and rejects BigInt and Set iteration that both the
    // Vite build and the server runtime handle natively.
    "target": "ES2022",
    "strict": true,
    // An import or a local nothing reads is refused: ten of them had piled
    // up (a toast imported on four pages that no longer raised one, a
    // locale read and dropped), each one a reader's question with no answer.
    "noUnusedLocals": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./Frontend/Web/src/*"],
      "@shared/*": ["./Shared/*"]
    }
  }
}
