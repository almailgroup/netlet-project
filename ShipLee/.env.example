# ShipLee's settings. In production they live in the Vercel project's
# Environment Variables, never in a file. Each one left unset turns its
# feature off; nothing stops the server starting.

# The database. Supabase's pooler address (Project Settings → Database →
# Connection string → Transaction pooler), or Vercel's own Postgres, which sets
# POSTGRES_URL by itself. The tables are made on the first request.
DATABASE_URL=

# The staff desk's password, at least 12 characters. Unset, /staff is closed.
STAFF_PASSWORD=

# Optional: signs staff sessions in place of the password. Changing either
# signs every staff device out.
SESSION_SECRET=

# The help page's contact details. Each is shown only once it is set.
SHIPLEE_PHONE=          # +96512345678
SHIPLEE_WHATSAPP=       # 96512345678 — country code, no plus
SHIPLEE_EMAIL=          # help@shiplee.delivery

# ShipLee AI: NetLet's Cloudflare Worker (Backend/gateway), which holds the
# Gemini key, and the secret ShipLee shares with it — the Worker's
# SHIPLEE_GATEWAY_SECRET, never NetLet's AI_GATEWAY_SECRET. Unset, ShipLee AI
# is not offered. README.md has the three steps.
SHIPLEE_AI_URL=         # https://netlet-ai-gateway.<account>.workers.dev
SHIPLEE_AI_SECRET=      # 32+ random characters

# Sample parcels kept in memory, for trying the site with no database.
# Never on the real deployment. `pnpm dev` turns it on by itself.
SHIPLEE_DEMO=
