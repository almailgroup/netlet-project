{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/products/:handle",
      "destination": "/api?__page=/products/:handle"
    },
    {
      "source": "/category/:slug",
      "destination": "/api?__page=/category/:slug"
    },
    {
      "source": "/stores/:slug",
      "destination": "/api?__page=/stores/:slug"
    },
    {
      "source": "/stores",
      "destination": "/api?__page=/stores"
    },
    {
      "source": "/categories",
      "destination": "/api?__page=/categories"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 15 * * *"
    }
  ]
}
