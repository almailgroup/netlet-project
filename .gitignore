# Dependencies
**/node_modules
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# The Vercel function bundle: 3.8MB of inlined dependencies, produced by
# `pnpm vercel-build`. Its hand-written `api/app.generated.d.ts` IS committed,
# so `pnpm check` passes on a clone that has not been built yet.
api/app.generated.js

# Secrets. `.env` is written by `pnpm setup:env` and never committed — it holds
# the database password and the Firebase service-account private key.
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*.swp
*~

# Logs and coverage
*.log
coverage/

# iOS native project.
# ios-app/ios IS committed, so the project opens in Xcode straight from a
# clone. These are the parts CocoaPods and Xcode regenerate, and must not be:
# Pods/ is ~100MB of vendored source, the .xcworkspace is written by
# `pod install`, and xcuserdata holds per-developer window state.
ios-app/ios/Pods/
ios-app/ios/*.xcworkspace
ios-app/ios/.xcode.env.local
**/xcuserdata/
ios-app/.expo/
