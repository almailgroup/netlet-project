.project-config.json

# iOS native project.
# ios-app/ios IS committed, so the project opens in Xcode straight from a clone.
# These are the parts CocoaPods and Xcode regenerate, and they must not be:
# Pods/ is ~100MB of vendored source, the .xcworkspace is written by
# `pod install`, and xcuserdata holds per-developer window state.
ios-app/ios/Pods/
ios-app/ios/*.xcworkspace
ios-app/ios/.xcode.env.local
**/xcuserdata/
ios-app/.expo/
api/app.generated.js
